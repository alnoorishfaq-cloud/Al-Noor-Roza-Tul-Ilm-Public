<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Al Noor Roza Tul Ilm Public High School, Manki, Swabi</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap">
<style>
:root{--bg:#f1f6f4;--card:#fff;--ink:#12302a;--mute:#5b736d;--line:#d5e2de;--green:#0f6b57;--green-t:#d6efe6;--red:#b3261e;--red-t:#fadcd9;--amber:#8a5a00;--amber-t:#fbebc4;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c1815;--card:#142520;--ink:#e3f1ed;--mute:#93aca5;--line:#27403a;--green:#4fc3a1;--green-t:#12372d;--red:#ff8a80;--red-t:#4a1b17;--amber:#f2c261;--amber-t:#43330c;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0c1815;--card:#142520;--ink:#e3f1ed;--mute:#93aca5;--line:#27403a;--green:#4fc3a1;--green-t:#12372d;--red:#ff8a80;--red-t:#4a1b17;--amber:#f2c261;--amber-t:#43330c;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 "Atkinson Hyperlegible",system-ui,sans-serif}
main{max-width:560px;margin:0 auto;padding:16px}
h1{font-size:1.5rem;margin:8px 0 2px}
.sub{color:var(--mute);margin:0 0 16px}
.tabs{display:flex;gap:6px;margin-bottom:14px}
.tabs button{flex:1;padding:10px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;font:inherit;font-weight:700;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--green);color:var(--bg);border-color:var(--green)}
.row{display:flex;gap:8px;align-items:center}
input{font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;min-width:0}
input:focus-visible,button:focus-visible{outline:3px solid var(--green);outline-offset:2px}
.btn{font:inherit;font-weight:700;border:0;border-radius:10px;padding:10px 14px;background:var(--green);color:var(--bg);cursor:pointer}
.btn.ghost{background:transparent;color:var(--green);border:1px solid var(--green)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}
.stat{padding:10px;border-radius:12px;text-align:center;font-weight:700}
.stat b{display:block;font-size:1.6rem;line-height:1.2}
.s-p{background:var(--green-t);color:var(--green)}.s-a{background:var(--red-t);color:var(--red)}.s-l{background:var(--amber-t);color:var(--amber)}
.item{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:8px}
.roll{width:34px;color:var(--mute);font-weight:700}
.name{flex:1;min-width:0;overflow-wrap:anywhere}
.seg{display:flex;gap:4px}
.seg button{width:42px;height:42px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--mute);font:inherit;font-weight:700;cursor:pointer}
.seg button.on[data-v="P"]{background:var(--green);color:var(--bg);border-color:var(--green)}
.seg button.on[data-v="A"]{background:var(--red);color:var(--bg);border-color:var(--red)}
.seg button.on[data-v="L"]{background:var(--amber);color:var(--bg);border-color:var(--amber)}
.pct{font-weight:700;min-width:52px;text-align:right}
.del{background:none;border:0;color:var(--mute);font-size:1.3rem;cursor:pointer;padding:4px 8px}
.empty{text-align:center;color:var(--mute);padding:28px 8px;border:1px dashed var(--line);border-radius:12px}
.bar{height:6px;border-radius:3px;background:var(--line);margin-top:4px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--green)}
.hint{color:var(--mute);font-size:.9rem;margin:6px 0 12px}
.clsbar{display:flex;gap:8px;margin-bottom:12px}
.tinfo{display:flex;align-items:center;gap:10px;background:var(--green-t);color:var(--green);border-radius:12px;padding:8px 8px 8px 14px;margin-bottom:12px;font-weight:700}
.tinfo span{flex:1;min-width:0;overflow-wrap:anywhere}
.tinfo .btn{padding:8px 12px}
select{flex:1;min-width:0;font:inherit;font-weight:700;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
select:focus-visible{outline:3px solid var(--green);outline-offset:2px}
.brand{display:flex;align-items:center;gap:12px;margin:4px 0 10px}
.brand img{width:64px;height:64px;border-radius:12px;background:#fff;flex:none}
.brand h1{font-size:1.2rem;line-height:1.25;margin:0}
.loc{margin:2px 0 0;color:var(--mute);font-weight:700}
.h2{font-size:1.05rem;margin:16px 0 8px}
.credit{margin:28px 0 8px;padding-top:12px;border-top:1px solid var(--line);text-align:center;color:var(--mute);font-size:.9rem}
.addgrid{display:grid;grid-template-columns:84px 1fr;gap:8px;margin-bottom:12px}
.addgrid #fname,.addgrid .row{grid-column:1/-1}
.chips{display:flex;gap:6px;margin-bottom:12px}
.chips button{flex:1;padding:8px 4px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;font:inherit;font-weight:700;cursor:pointer}
.chips button[aria-pressed="true"]{background:var(--green);color:var(--bg);border-color:var(--green)}
.sub2{color:var(--mute);font-size:.85rem;font-weight:400}
.tag{display:inline-block;padding:0 8px;border-radius:999px;background:var(--green-t);color:var(--green);font-weight:700;font-size:.78rem;margin-left:4px}
/* colorful theme */
:root{--blue:#1d5fd1;--blue-t:#dbe8ff;--purple:#6d3bd2;--purple-t:#e8defc;--orange:#d9630b;--orange-t:#ffe6d1;--page:linear-gradient(180deg,#dff3ea 0,#e6eefc 50%,#f4e8fa 100%);--hero:linear-gradient(135deg,#0f6b57,#12839a 55%,#2a5bd7)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--blue:#7aa7ff;--blue-t:#172a52;--purple:#b799ff;--purple-t:#2b1d52;--orange:#ffab6b;--orange-t:#4a2a10;--page:linear-gradient(180deg,#0a1a16 0,#0b1427 55%,#160d26 100%)}}
:root[data-theme="dark"]{--blue:#7aa7ff;--blue-t:#172a52;--purple:#b799ff;--purple-t:#2b1d52;--orange:#ffab6b;--orange-t:#4a2a10;--page:linear-gradient(180deg,#0a1a16 0,#0b1427 55%,#160d26 100%)}
body{background:var(--page);background-attachment:fixed}
.brand{padding:14px;border-radius:18px;background:var(--hero);box-shadow:0 6px 18px rgba(15,107,87,.28)}
.brand h1{color:#fff}
.brand .loc{color:#d9f3ea}
.brand img{border:3px solid rgba(255,255,255,.75)}
.sub{font-weight:700;color:var(--green)}
.btn{background:var(--hero);color:#fff}
.btn.ghost{background:transparent;color:var(--green)}
input,select{border-width:2px;border-color:var(--blue-t)}
.tabs button{border-width:2px;font-size:1rem}
.tabs button#t-mark{color:var(--green);border-color:var(--green)}
.tabs button#t-students{color:var(--blue);border-color:var(--blue)}
.tabs button#t-report{color:var(--purple);border-color:var(--purple)}
.tabs button#t-mark[aria-selected="true"]{background:linear-gradient(135deg,#12a37c,#0f6b57);color:#fff}
.tabs button#t-students[aria-selected="true"]{background:linear-gradient(135deg,#3b82f6,#1d4fc4);color:#fff}
.tabs button#t-report[aria-selected="true"]{background:linear-gradient(135deg,#9b6bff,#6232d1);color:#fff}
.stat{box-shadow:0 4px 12px rgba(0,0,0,.14)}
.s-p{background:linear-gradient(135deg,#22b88f,#0f6b57);color:#fff}
.s-a{background:linear-gradient(135deg,#f0646a,#b3261e);color:#fff}
.s-l{background:linear-gradient(135deg,#f7b733,#c77700);color:#fff}
.item{border-width:1px 1px 1px 5px;border-left-color:var(--line);box-shadow:0 2px 8px rgba(0,0,0,.06)}
.item.st-P{border-left-color:#1aa57f}
.item.st-A{border-left-color:#e5484d}
.item.st-L{border-left-color:#f5a524}
.roll{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--green-t);color:var(--green);font-size:.85rem;flex:none}
.item:nth-child(4n+2) .roll{background:var(--blue-t);color:var(--blue)}
.item:nth-child(4n+3) .roll{background:var(--purple-t);color:var(--purple)}
.item:nth-child(4n+4) .roll{background:var(--orange-t);color:var(--orange)}
.seg button{border-width:2px}
.seg button[data-v="P"]{color:var(--green);border-color:var(--green-t)}
.seg button[data-v="A"]{color:var(--red);border-color:var(--red-t)}
.seg button[data-v="L"]{color:var(--amber);border-color:var(--amber-t)}
.tinfo{background:linear-gradient(90deg,var(--green-t),var(--blue-t));color:var(--ink)}
.tinfo span{color:var(--ink)}
.chips button{border-width:2px;color:var(--blue);border-color:var(--blue-t)}
.chips button[data-g="Hifaz ul Quran"]{color:var(--green);border-color:var(--green-t)}
.chips button[data-g="Nazira"]{color:var(--purple);border-color:var(--purple-t)}
.chips button[aria-pressed="true"]{color:#fff;background:linear-gradient(135deg,#3b82f6,#1d4fc4);border-color:transparent}
.chips button[data-g="Hifaz ul Quran"][aria-pressed="true"]{background:linear-gradient(135deg,#12a37c,#0f6b57)}
.chips button[data-g="Nazira"][aria-pressed="true"]{background:linear-gradient(135deg,#9b6bff,#6232d1)}
.bar{height:8px}
.bar i{background:linear-gradient(90deg,#22b88f,#3b82f6,#9b6bff)}
.pct{color:var(--blue)}
.h2{color:var(--purple)}
.empty{background:var(--card);border-color:var(--blue)}
.credit{color:var(--purple);font-weight:700}
[hidden]{display:none!important}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>
<body>
<main>
  <header class="brand"><img src="data:image/jpeg;base64," id="logo" alt="Al-Noor school logo" width="64" height="64"><div><h1>Al Noor Roza Tul Ilm Public High School</h1><p class="loc">Manki, Swabi</p></div></header>
  <p class="sub">Student attendance: take daily attendance and view reports.</p>
  <div class="chips" id="chips"></div>
  <div class="clsbar">
    <select id="cls" aria-label="Class"></select>
    <button class="btn ghost" id="newCls">+ New class</button>
  </div>
  <div class="tinfo" id="tinfo"></div>
  <div class="row" id="clsForm" hidden style="margin-bottom:12px;flex-wrap:wrap">
    <input id="clsName" placeholder="Class name (e.g. 5-A)" aria-label="Class name" style="flex:1 1 150px">
    <input id="tName" placeholder="Teacher name" aria-label="Teacher name" style="flex:1 1 150px">
    <select id="cGrp" aria-label="Group" style="flex:1 1 120px"><option value="">No group</option><option value="Hifaz ul Quran">Hifaz ul Quran</option><option value="Nazira">Nazira</option></select>
    <button class="btn" id="clsOk">Save</button>
    <button class="btn ghost" id="clsCancel">Cancel</button>
  </div>

  <div class="tabs" role="tablist">
    <button role="tab" id="t-mark" aria-selected="true">Attendance</button>
    <button role="tab" id="t-students" aria-selected="false">Students</button>
    <button role="tab" id="t-report" aria-selected="false">Report</button>
  </div>

  <section id="v-mark">
    <div class="row">
      <input type="date" id="date" aria-label="Date" style="flex:1">
      <button class="btn ghost" id="allP">Mark all present</button>
    </div>
    <div class="stats">
      <div class="stat s-p"><b id="cP">0</b>Present</div>
      <div class="stat s-a"><b id="cA">0</b>Absent</div>
      <div class="stat s-l"><b id="cL">0</b>Leave</div>
    </div>
    <div id="markList"></div>
    <p class="hint">P = Present, A = Absent, L = Leave. Every tap is saved automatically.</p>
    <button class="btn" id="pdfBtn" hidden>Download PDF for this day</button>
    <p class="hint" id="pdfMsg" role="status"></p>
  </section>

  <section id="v-students" hidden>
    <div class="addgrid">
      <input id="roll" inputmode="numeric" placeholder="Roll" aria-label="Roll number">
      <input id="sname" placeholder="Student name" aria-label="Student name">
      <input id="fname" placeholder="Father name" aria-label="Father name">
      <button class="btn" id="add" style="grid-column:1/-1">Add student</button>
    </div>
    <div style="margin-bottom:14px">
      <button class="btn ghost" id="xbtn">Import names from Excel</button>
      <button class="btn ghost" id="tplBtn" hidden style="margin-left:6px">Download Excel template</button>
      <input type="file" id="xfile" accept=".xlsx,.xls,.csv" hidden>
      <p class="hint" id="xmsg">Columns: Roll No, Student Name, Father Name. Only the name is required. Students are added to the class selected above.</p>
      <div id="xprev" hidden></div>
    </div>
    <div id="stuList"></div>
    <button class="btn ghost" id="delCls" style="margin-top:12px">Delete class</button>
  </section>

  <section id="v-report" hidden>
    <p class="hint" id="repHint"></p>
    <h2 class="h2" id="dayHead" hidden>Daily PDF reports</h2>
    <div id="dayList"></div>
    <h2 class="h2">Attendance by student</h2>
    <div id="repList"></div>
  </section>
<footer class="credit">Prepared by Muhammad Ishfaq<br>Phone # 03149768207</footer>
</main>

<script>
(function(){
  var KEY="attendance-v1";
  var S={students:[],records:{}};
  try{var raw=localStorage.getItem(KEY);if(raw){var p=JSON.parse(raw);if(p&&p.students&&p.records)S=p;}}catch(e){}
  if(!S.classes||!S.classes.length){S.classes=[{id:"c1",name:"Class 1"}]}
  S.students.forEach(function(s){if(!s.cls)s.cls=S.classes[0].id});
  S.classes.forEach(function(c){if(c.grp==="Hifz")c.grp="Hifaz ul Quran"});
  if(!S.cur||!S.classes.some(function(c){return c.id===S.cur}))S.cur=S.classes[0].id;
  function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
  var $=function(id){return document.getElementById(id)};
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
  function today(){var d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
  var dateEl=$("date");dateEl.value=today();

  var tabs=["mark","students","report"];
  function show(t){tabs.forEach(function(n){$("v-"+n).hidden=n!==t;$("t-"+n).setAttribute("aria-selected",n===t)});render()}
  tabs.forEach(function(n){$("t-"+n).onclick=function(){show(n)}});

  function rec(){return S.records[dateEl.value]||(S.records[dateEl.value]={})}
  var gf="";
  function inCls(){return S.students.filter(function(s){return s.cls===S.cur})}
  function sorted(){return inCls().sort(function(a,b){return (parseInt(a.roll)||0)-(parseInt(b.roll)||0)})}

  function renderMark(){
    var list=$("markList"),r=S.records[dateEl.value]||{},c={P:0,A:0,L:0};
    if(!sorted().length){list.innerHTML='<div class="empty">No students in this class yet. Go to the Students tab to add names.</div>'}
    else list.innerHTML=sorted().map(function(s){
      var v=r[s.id];if(v)c[v]++;
      return '<div class="item st-'+(v||"N")+'"><span class="roll">'+esc(s.roll||"-")+'</span><span class="name">'+nameHtml(s)+'</span><div class="seg">'+
      ["P","A","L"].map(function(k){return '<button data-id="'+s.id+'" data-v="'+k+'" class="'+(v===k?"on":"")+'" aria-pressed="'+(v===k)+'" aria-label="'+k+' for '+esc(s.name)+'">'+k+'</button>'}).join("")+'</div></div>'}).join("");
    $("cP").textContent=c.P;$("cA").textContent=c.A;$("cL").textContent=c.L;
  }
  $("markList").onclick=function(e){
    var b=e.target.closest("button[data-id]");if(!b)return;
    var r=rec();r[b.dataset.id]=r[b.dataset.id]===b.dataset.v?undefined:b.dataset.v;
    if(!r[b.dataset.id])delete r[b.dataset.id];
    save();renderMark();
  };
  $("allP").onclick=function(){var r=rec();sorted().forEach(function(s){r[s.id]="P"});save();renderMark()};
  dateEl.onchange=function(){if(!dateEl.value)dateEl.value=today();renderMark()};

  function renderStudents(){
    $("stuList").innerHTML=sorted().length?sorted().map(function(s){
      return '<div class="item"><span class="roll">'+esc(s.roll||"-")+'</span><span class="name">'+nameHtml(s)+'</span><button class="del" data-del="'+s.id+'" aria-label="Remove '+esc(s.name)+'">&times;</button></div>'}).join("")
      :'<div class="empty">Type a roll number and name above, then tap Add.</div>';
  }
  function addStudent(){
    var n=$("sname").value.trim();if(!n){$("sname").focus();return}
    if(!S.cur){xmsg("Create a class in this group first (tap + New class).");return}
    S.students.push({id:"s"+Date.now()+Math.floor(Math.random()*1000),name:n,roll:$("roll").value.trim(),father:$("fname").value.trim(),cls:S.cur});
    $("sname").value="";$("fname").value="";$("roll").value=String((parseInt($("roll").value)||0)+1===1&&!$("roll").value?"":(parseInt($("roll").value)||0)+1);
    save();renderStudents();$("sname").focus();
  }
  $("add").onclick=addStudent;
  $("sname").onkeydown=function(e){if(e.key==="Enter")addStudent()};
  $("stuList").onclick=function(e){
    var b=e.target.closest("button[data-del]");if(!b)return;
    var s=S.students.filter(function(x){return x.id===b.dataset.del})[0];
    if(!s)return;
    if(b.dataset.arm!=="1"){b.dataset.arm="1";b.textContent="Remove?";b.style.fontSize=".9rem";setTimeout(function(){b.dataset.arm="";b.textContent="\u00d7";b.style.fontSize=""},3000);return}
    S.students=S.students.filter(function(x){return x.id!==s.id});
    Object.keys(S.records).forEach(function(d){delete S.records[d][s.id]});
    save();renderStudents();
  };

  function renderReport(){
    var ids=sorted().map(function(s){return s.id});
    var days=Object.keys(S.records).filter(function(d){return ids.some(function(id){return S.records[d][id]})});
    renderDays(days);
    $("repHint").textContent=(curCls().teacher?"Teacher: "+curCls().teacher+". ":"")+(days.length?days.length+(days.length===1?" day":" days")+" of attendance recorded.":"");
    if(!ids.length||!days.length){$("repList").innerHTML='<div class="empty">The report appears after you mark attendance for at least one day.</div>';return}
    $("repList").innerHTML=sorted().map(function(s){
      var p=0,a=0,l=0;
      days.forEach(function(d){var v=S.records[d][s.id];if(v==="P")p++;else if(v==="A")a++;else if(v==="L")l++});
      var t=p+a+l,pc=t?Math.round(p/t*100):0;
      return '<div class="item" style="display:block"><div class="row"><span class="roll">'+esc(s.roll||"-")+'</span><span class="name">'+nameHtml(s)+'</span><span class="pct">'+pc+'%</span></div>'+
      '<div class="bar"><i style="width:'+pc+'%"></i></div><div class="hint" style="margin:6px 0 0">Present '+p+' · Absent '+a+' · Leave '+l+'</div></div>'}).join("");
  }
  function renderClasses(){
    $("cls").innerHTML=!visCls().length?'<option>No classes</option>':visCls().map(function(c){return '<option value="'+c.id+'"'+(c.id===S.cur?' selected':'')+'>'+esc(c.name)+(c.grp&&!gf?' ['+esc(c.grp)+']':'')+(c.teacher?' - '+esc(c.teacher):'')+' ('+S.students.filter(function(s){return s.cls===c.id}).length+')</option>'}).join("");
  }
  $("cls").onchange=function(){S.cur=$("cls").value;pending=[];$("xprev").hidden=true;save();render()};
  var editing=null;
  function openForm(c){editing=c;$("clsForm").hidden=false;$("clsName").value=c?c.name:"";$("tName").value=c?(c.teacher||""):"";$("cGrp").value=c?(c.grp||""):gf;$("clsName").focus()}
  $("newCls").onclick=function(){openForm(null)};
  function saveClass(){
    var n=$("clsName").value.trim();if(!n){$("clsName").focus();return}
    var t=$("tName").value.trim(),g=$("cGrp").value;
    if(editing){editing.name=n;editing.teacher=t;editing.grp=g;if(gf&&g!==gf)gf=g;$("clsForm").hidden=true;save();render();return}
    var c={id:"c"+Date.now(),name:n,teacher:t,grp:g};S.classes.push(c);if(gf&&g!==gf)gf=g;S.cur=c.id;$("clsForm").hidden=true;save();show("students");
  }
  $("clsOk").onclick=saveClass;
  $("clsName").onkeydown=function(e){if(e.key==="Enter")saveClass()};
  $("clsCancel").onclick=function(){$("clsForm").hidden=true};
  $("delCls").onclick=function(){
    var b=$("delCls");if(!S.cur)return;
    if(S.classes.length<2){b.textContent="Keep at least one class";setTimeout(function(){b.textContent="Delete class"},2500);return}
    if(b.dataset.arm!=="1"){b.dataset.arm="1";b.textContent="Sure? Tap again to delete";setTimeout(function(){b.dataset.arm="";b.textContent="Delete class"},3000);return}
    b.dataset.arm="";b.textContent="Delete class";
    var id=S.cur;
    S.students.filter(function(s){return s.cls===id}).forEach(function(s){Object.keys(S.records).forEach(function(d){delete S.records[d][s.id]})});
    S.students=S.students.filter(function(s){return s.cls!==id});
    S.classes=S.classes.filter(function(c){return c.id!==id});S.cur=S.classes[0].id;save();render();
  };
  var pending=[],HINT=$("xmsg").textContent;
  function xmsg(t){$("xmsg").textContent=t}
  function parseSimple(rows){
    var out=[];
    rows.forEach(function(r){
      var cells=r.map(function(x){return String(x==null?"":x).trim()}).filter(Boolean);
      if(!cells.length)return;
      var roll="",name="";
      cells.forEach(function(c){var num=/^\d{1,5}$/.test(c);if(num){if(!roll)roll=c}else if(!name)name=c});
      if(!name||/^(students?\s*)?(name|naam)s?$/i.test(name)||/^(roll|sr|s\.?\s*no|serial)/i.test(name))return;
      out.push({name:name,roll:roll});
    });
    return out;
  }
  $("xbtn").onclick=function(){$("xfile").click()};
  $("xfile").onchange=function(){
    var f=this.files[0];this.value="";if(!f)return;
    if(!S.cur){xmsg("Create a class in this group first (tap + New class).");return}
    if(!window.XLSX){xmsg("The Excel reader did not load. Check your internet connection and reload the page.");return}
    var rd=new FileReader();
    rd.onload=function(){
      try{
        var wb=XLSX.read(new Uint8Array(rd.result),{type:"array"});
        var rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,raw:false,defval:""});
        var have={},seen={},all=parseRows(rows);
        inCls().forEach(function(s){have[key(s)]=1});
        pending=all.filter(function(x){var k=key(x);if(have[k]||seen[k])return false;seen[k]=1;return true});
        showPrev(all.length-pending.length);
      }catch(e){pending=[];$("xprev").hidden=true;xmsg("Could not read this file. Choose an .xlsx, .xls or .csv file.")}
    };
    rd.onerror=function(){xmsg("The file could not be opened. Please try again.")};
    rd.readAsArrayBuffer(f);
  };
  function showPrev(skipped){
    var p=$("xprev");
    if(!pending.length){p.hidden=true;xmsg(skipped?"All these names are already in this class.":"No names found in this file. Put the names in one column.");return}
    xmsg(pending.length+" new names found"+(skipped?" ("+skipped+" already in this class, skipped)":"")+". Class: "+curCls().name);
    p.hidden=false;
    p.innerHTML='<div class="item" style="display:block;max-height:180px;overflow:auto">'+pending.slice(0,50).map(function(x){return '<div><span class="roll" style="display:inline-block">'+esc(x.roll||"-")+'</span> '+esc(x.name)+(x.father?' ('+esc(x.father)+')':'')+(x.grp?' - '+esc(x.grp):'')+'</div>'}).join("")+(pending.length>50?'<div class="hint">and '+(pending.length-50)+' more</div>':'')+'</div><div class="row" style="margin-bottom:12px"><button class="btn" id="xok">Add to this class</button><button class="btn ghost" id="xno">Cancel</button></div>';
    $("xok").onclick=importNow;
    $("xno").onclick=function(){pending=[];p.hidden=true;xmsg(HINT)};
  }
  function importNow(){
    var max=0;inCls().forEach(function(s){max=Math.max(max,parseInt(s.roll)||0)});
    pending.forEach(function(x,i){S.students.push({id:"s"+Date.now()+i+Math.floor(Math.random()*1000),name:x.name,father:x.father||"",grp:x.grp||"",roll:x.roll||String(++max),cls:S.cur})});
    var n=pending.length;pending=[];$("xprev").hidden=true;save();render();xmsg(n+" students added.");
  }
  var dl=null;
  if(window.claude&&window.claude.use){window.claude.use("downloads").then(function(d){if(!d)return;dl=d;$("pdfBtn").hidden=false;$("tplBtn").hidden=false;renderReport()}).catch(function(){})}
  function fmtDate(d){var q=d.split("-");return new Date(+q[0],+q[1]-1,+q[2]).toLocaleDateString("en-GB",{weekday:"long",day:"numeric",month:"long",year:"numeric"})}
  function lat(s){return String(s).replace(/[^\x20-\xFF]/g,"?")}
  function renderDays(days){
    var show=!!dl&&days.length>0;
    $("dayHead").hidden=!show;
    $("dayList").innerHTML=show?days.slice().sort().reverse().map(function(d){
      var c={P:0,A:0,L:0};sorted().forEach(function(s){var v=S.records[d][s.id];if(v)c[v]++});
      return '<div class="item"><span class="name">'+esc(fmtDate(d))+'<div class="hint" style="margin:0">Present '+c.P+', Absent '+c.A+', Leave '+c.L+'</div></span><button class="btn ghost" data-pdf="'+d+'" aria-label="Download PDF for '+esc(fmtDate(d))+'">PDF</button></div>'}).join(""):"";
  }
  $("dayList").onclick=function(e){var b=e.target.closest("button[data-pdf]");if(b)makePdf(b.dataset.pdf,$("repHint"))};
  $("pdfBtn").onclick=function(){makePdf(dateEl.value,$("pdfMsg"))};
  function makePdf(date,out){
    var list=sorted(),r=S.records[date]||{},c=curCls();
    if(!dl){out.textContent="PDF download is not available in this view.";return}
    if(!window.jspdf){out.textContent="The PDF tool did not load. Check your internet connection and reload the page.";return}
    if(!list.length){out.textContent="Add students to this class first.";return}
    var cnt={P:0,A:0,L:0,N:0};list.forEach(function(s){cnt[r[s.id]||"N"]++});
    if(cnt.N===list.length){out.textContent="Mark attendance for this day first.";return}
    var doc=new window.jspdf.jsPDF({unit:"mm",format:"a4"}),M=15,W=210,y=0;
    var label={P:"Present",A:"Absent",L:"Leave",N:"Not marked"},col={P:[15,107,87],A:[179,38,30],L:[138,90,0],N:[91,115,109]};
    doc.setFillColor(15,107,87);doc.rect(0,0,W,6,"F");doc.setFillColor(29,95,209);doc.rect(0,6,W,2,"F");
    try{doc.addImage($("logo").src,"JPEG",M,12,22,22)}catch(e){}
    doc.setFont("helvetica","bold");doc.setFontSize(15);doc.setTextColor(15,107,87);doc.text("Al Noor Roza Tul Ilm Public High School",M+27,21);
    doc.setFont("helvetica","normal");doc.setFontSize(11);doc.text("Manki, Swabi",M+27,28);
    doc.setTextColor(0);doc.setDrawColor(200);doc.line(M,38,W-M,38);
    doc.setFont("helvetica","bold");doc.setFontSize(13);doc.setTextColor(29,95,209);doc.text("Daily Attendance Report",M,48);doc.setTextColor(0);
    doc.setFont("helvetica","normal");doc.setFontSize(11);
    doc.text("Class: "+lat(c.name),M,56);doc.text("Teacher: "+lat(c.teacher||"-"),M,62);doc.text("Date: "+fmtDate(date)+(c.grp?"      Group: "+c.grp:""),M,68);
    doc.text("Present: "+cnt.P+"    Absent: "+cnt.A+"    Leave: "+cnt.L+"    Not marked: "+cnt.N+"    Total: "+list.length,M,77);
    function fit(t,w){return doc.splitTextToSize(lat(t),w)[0]||""}
    function th(){doc.setFillColor(214,232,255);doc.rect(M,y-5,W-2*M,8,"F");doc.setTextColor(0);doc.setFont("helvetica","bold");doc.setFontSize(10.5);doc.text("Roll",M+2,y);doc.text("Name",M+16,y);doc.text("Father Name",M+68,y);doc.text("Status",150,y);doc.setFont("helvetica","normal")}
    y=88;th();y+=8;
    list.forEach(function(s){
      if(y>278){doc.addPage();y=20;th();y+=8}
      var v=r[s.id]||"N";
      doc.setTextColor(0);doc.text(lat(s.roll||"-"),M+2,y);doc.text(fit(s.name,50),M+16,y);doc.text(fit(s.father||"-",60),M+68,y);
      doc.setTextColor(col[v][0],col[v][1],col[v][2]);doc.text(label[v],150,y);
      doc.setTextColor(0);doc.setDrawColor(225);doc.line(M,y+2.5,W-M,y+2.5);y+=7.5;
    });
    if(y>262){doc.addPage();y=30}
    y+=14;doc.setTextColor(0);doc.setDrawColor(120);doc.line(W-M-60,y,W-M,y);doc.text("Teacher signature",W-M-60,y+6);
    var np=doc.getNumberOfPages();for(var i=1;i<=np;i++){doc.setPage(i);doc.setFont("helvetica","normal");doc.setFontSize(9);doc.setTextColor(91,115,109);doc.text("Prepared by Muhammad Ishfaq  |  Phone # 03149768207",W/2,289,{align:"center"})}
    var cls=String(c.name).replace(/[^\w-]+/g,"-");
    out.textContent="";
    dl.save({filename:"attendance-"+cls+(c.grp?"-"+c.grp.replace(/\s+/g,"-"):"")+"-"+date+".pdf",data:doc.output("blob")})
      .then(function(){out.textContent="PDF saved for "+fmtDate(date)+"."})
      .catch(function(e){out.textContent=(e&&e.code==="declined")?"":"The PDF could not be saved. Please try again."});
  }
  function visCls(){return S.classes.filter(function(c){return !gf||c.grp===gf})}
  function fixCur(){var v=visCls();if(!v.some(function(c){return c.id===S.cur}))S.cur=v.length?v[0].id:null}
  function key(s){return (s.name+"|"+(s.father||"")).toLowerCase()}
  function nameHtml(s){return esc(s.name)+(s.father?'<div class="sub2">Father: '+esc(s.father)+'</div>':'')}
  function renderChips(){
    var gmap={};S.classes.forEach(function(c){gmap[c.id]=c.grp||""});
    var n={"":S.students.length,"Hifaz ul Quran":0,Nazira:0};
    S.students.forEach(function(s){var g=gmap[s.cls];if(g&&n[g]!=null)n[g]++});
    $("chips").innerHTML=[["","All groups"],["Hifaz ul Quran","Hifaz ul Quran"],["Nazira","Nazira"]].map(function(g){return '<button data-g="'+g[0]+'" aria-pressed="'+(gf===g[0])+'">'+g[1]+' ('+n[g[0]]+')</button>'}).join("");
  }
  $("chips").onclick=function(e){var b=e.target.closest("button[data-g]");if(!b)return;gf=b.dataset.g;render()};
  function normGrp(s){s=String(s||"").toLowerCase();return /hifz|hifaz|hafiz/.test(s)?"Hifz":/nazira|nazra/.test(s)?"Nazira":""}
  function parseRows(rows){
    var hi=-1,ix={};
    for(var k=0;k<Math.min(rows.length,5)&&hi<0;k++){
      var m={};
      rows[k].forEach(function(x,i){
        var c=String(x==null?"":x).trim().toLowerCase();
        if(/father|walid|guardian/.test(c)){if(m.f==null)m.f=i}
        else if(/^(student'?s?\s*)?(name|naam)$/.test(c)){if(m.n==null)m.n=i}
        else if(/roll|^sr|serial|^s\.?\s*no/.test(c)){if(m.r==null)m.r=i}
        else if(/group|hifz|nazira/.test(c)){if(m.g==null)m.g=i}
      });
      if(m.n!=null){hi=k;ix=m}
    }
    if(hi<0)return parseSimple(rows);
    var out=[];
    rows.slice(hi+1).forEach(function(r){
      var g=function(i){return i==null?"":String(r[i]==null?"":r[i]).trim()};
      var name=g(ix.n);if(!name)return;
      out.push({name:name,roll:g(ix.r),father:g(ix.f),grp:normGrp(g(ix.g))});
    });
    return out;
  }
  $("tplBtn").onclick=function(){
    if(!dl||!window.XLSX){xmsg("Template download is not available. Check your internet connection.");return}
    var ws=XLSX.utils.aoa_to_sheet([["Roll No","Student Name","Father Name"],[1,"Ahmed Khan","Gul Khan"],[2,"Bilal Shah","Noor Shah"]]);
