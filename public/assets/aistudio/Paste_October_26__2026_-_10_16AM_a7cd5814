    dl.save({filename:"student-import-template.xlsx",data:new Blob([arr],{type:"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"})})
      .then(function(){xmsg("Template saved. Fill it in, then import it here.")})
      .catch(function(e){if(!(e&&e.code==="declined"))xmsg("The template could not be saved. Please try again.")});
  };
  function curCls(){return S.classes.filter(function(c){return c.id===S.cur})[0]||{id:null,name:"",teacher:"",grp:""}}
  function renderTeacher(){
    var c=curCls(),n=inCls().length;
    if(!c.id){$("tinfo").innerHTML='<span>No classes here yet. Tap + New class to add one.</span>';return}
    $("tinfo").innerHTML='<span>'+(c.grp?esc(c.grp)+' | ':'')+'Teacher: '+(c.teacher?esc(c.teacher):'name not set')+', '+n+(n===1?' student':' students')+'</span><button class="btn ghost" id="editCls">Edit</button>';
    $("editCls").onclick=function(){openForm(c)};
  }
